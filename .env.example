# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Company (header preview quotation/invoice) ────────────
COMPANY_NAME=Makromedia
COMPANY_ADDRESS="Malang, Jawa Timur, Indonesia"
COMPANY_PHONE=
