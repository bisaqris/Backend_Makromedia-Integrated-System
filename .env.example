# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://makromedia:makromedia@localhost:5433/makromedia_db?schema=public"

# ── App ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Auth (JWT) ────────────────────────────────────────────
JWT_SECRET="ganti-dengan-secret-yang-kuat-dan-acak"
