# ===== Production (docker-compose.prod.yml) =====

NODE_ENV=production

# ----- API -----
PORT=4000
# WAJIB: secret kuat, min 16 char, BUKAN placeholder.  Buat dengan:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Origin frontend untuk CORS (domain publik kamu)
FRONTEND_URL=https://app.domainmu.com

# ----- Postgres (internal, tidak diekspos publik) -----
POSTGRES_USER=makromedia
# WAJIB: password kuat
POSTGRES_PASSWORD=
POSTGRES_DB=makromedia_db

# ----- Cloudflare Tunnel -----
# Token dari Cloudflare Zero Trust > Networks > Tunnels > (buat tunnel) > Docker.
# Public hostname tunnel diarahkan ke service:  http://api:4000
CLOUDFLARE_TUNNEL_TOKEN=

# ----- Header perusahaan (opsional, untuk preview dokumen) -----
COMPANY_NAME=Makromedia
COMPANY_ADDRESS="Malang, Jawa Timur, Indonesia"
